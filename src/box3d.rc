// Version resource for the Windows DLL build. Anonymous, metadata-less native DLLs
// score badly with antivirus heuristics; this identifies the binary and its shipper.
// (Vendored addition for the MineMogul fork — CompanyName/ProductName are the game's.)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NoodleForge LLC"
            VALUE "FileDescription", "Box3D physics engine (MineMogul build)"
            VALUE "FileVersion", "0.2.0.0"
            VALUE "InternalName", "box3d"
            VALUE "LegalCopyright", "Copyright (C) 2026 Erin Catto. MIT License."
            VALUE "OriginalFilename", "box3d.dll"
            VALUE "ProductName", "MineMogul"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
